<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>NbaHub.Web</RootNamespace>
    <UserSecretsId>nbahub-web-6f1c2a4e</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <!-- Lets `dotnet ef` use the web app as the startup project; not shipped at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the repository's seed files with the app so the seed command works locally and in the container. -->
    <None Include="..\..\seed\*.json" Link="seed\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NbaHub.Application\NbaHub.Application.csproj" />
    <ProjectReference Include="..\NbaHub.Infrastructure\NbaHub.Infrastructure.csproj" />
    <ProjectReference Include="..\NbaHub.Web.Client\NbaHub.Web.Client.csproj" />
  </ItemGroup>

</Project>
